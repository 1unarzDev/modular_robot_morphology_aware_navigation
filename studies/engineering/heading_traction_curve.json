  "no_platform_change": "The model tree is unmodified for every run here. This measures the platform as every committed figure was collected on it.",
  "predictions_declared_before_running": {
    "assembled": "Rotation authority and straight travel both vary with a 180-degree period, full near 0 and 180 and collapsing near 90. The shape between is not predicted: an elliptical combination of mu 1.2 and mu2 0.08 would fall off slowly and collapse only very near 90, while a sharper transition would mean a wider band of unusable headings.",
    "detached": "The detached pod shows the same dependence, since its wheels come from the same template. If it does not, the reach of the defect is narrower than currently stated and the detached half of Gate 0 item 1 survives a repair unchanged.",
    "what_would_surprise": "Any asymmetry between a heading and its 180-degree partner, which world-fixed friction axes cannot produce."
  },
  "protocol": {
    "assembled": {
      "headings_deg": [
        0,
        15,
        30,
        45,
        60,
        75,
        90,
        105,
        120,
        135,
        150,
        165,
        180
      ],
      "pose": "imposed with gz set_pose at the spawn position, settled before the declared stage sequence",
      "rate_choice": "0.35 rad/s is the rate Gate 0 item 1 was collected at, so the rotation and travel columns are directly comparable with the committed figures. The rate sweep already showed no rate dependence between 0.20 and 0.35, and the collapse has been measured at 0.271, so this also tests it at the gate's own rate.",
      "tool": "qualify_assembly_motion --yaw-rate 0.35 --expected-morphology compact_diff"
    },
    "declared_before_running": true,
    "detached": {
      "headings_deg": [
        0,
        90,
        -90
      ],
      "pose": "imposed on the self_mobile_pod model at its spawn position",
      "tool": "qualify_detached_pod",
      "world": "self_mobile_pod_qualification.sdf, unchanged"
    },
    "hygiene": "one simulator only; each case aborts unless the simulator process count is zero beforehand, and tears down afterwards",
    "obstruction_free_world": "The straight stage must measure traction, not geometry. In the retained smoke world the straight stage reaches 0.7397 m at heading 0, 0.5830 m at +/-90 and 0.2238 m at 180, and the last of those is an obstruction rather than a traction effect. The assembled runs therefore use indoor_doorway.sdf with its six wall models removed and nothing else changed: the same ground plane, which declares no friction and so runs at the SDF default of 1.0, and the same spawn position (1.0, 2.75, 0.18). The detached-pod world already contains only a ground plane and the pod, so it is used unchanged."
  },

{
  "name": "Morphology Navigation ROS 2 Jazzy",
  "dockerComposeFile": ["docker-compose.yml", "docker-compose.override.yml"],
  "service": "dev",
  "runServices": ["dev"],
  "workspaceFolder": "/home/roboboat/morphology_ws",
  "postCreateCommand": ".devcontainer/postcreate.sh",
  "containerUser": "roboboat",
  "remoteUser": "roboboat",
  "updateRemoteUserUID": true,
  "overrideCommand": true,
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.cpptools",
        "twxs.cmake",
        "ms-python.python",
        "eamodio.gitlens"
      ]
    }
  }
}


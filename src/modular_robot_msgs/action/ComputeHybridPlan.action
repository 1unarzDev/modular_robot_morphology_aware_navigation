geometry_msgs/PoseStamped start
geometry_msgs/PoseStamped goal
string start_morphology
float32 initial_epsilon
string planner_method
uint64 expected_topology_revision
uint64 expected_sensing_revision
# Proposal (predetach_check_v1): sites the navigator's pre-detach station check
# rejected, as a JSON list (morphology_planner.predetach_check.SiteRejection).
# Empty for every other method, and ignored unless the method is a checked one.
string site_exclusions_json
---
bool success
string message
modular_robot_msgs/HybridPlan plan
# Aggregated transition-edge decisions evaluated during search, one JSON object
# per distinct (method, transition_id, feasible, reasons) with its count.
string[] transition_decision_json
---
uint32 expanded_states
float64 incumbent_cost
float32 epsilon

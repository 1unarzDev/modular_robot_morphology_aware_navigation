<?xml version="1.0"?>
<sdf version="1.10">
  <model name="@POD_MODEL@">
    <self_collide>true</self_collide>
    <link name="@POD_ID@_base_link">
      <inertial><mass>2.1</mass><inertia><ixx>0.006</ixx><iyy>0.008</iyy><izz>0.009</izz></inertia></inertial>
      <visual name="@POD_ID@_body_visual"><pose>0 0 0.07 0 0 0</pose><geometry><box><size>0.18 0.10 0.10</size></box></geometry><material><diffuse>0.95 0.35 0.05 1</diffuse></material></visual>
      <collision name="@POD_ID@_body_collision"><pose>0 0 0.07 0 0 0</pose><geometry><box><size>0.18 0.10 0.10</size></box></geometry></collision>
    </link>
    <link name="@POD_ID@_left_carrier"><pose relative_to="@POD_ID@_base_link">0 0.07 0.055 0 0 0</pose><inertial><mass>0.05</mass><inertia><ixx>0.00002</ixx><iyy>0.00002</iyy><izz>0.00002</izz></inertia></inertial></link>
    <link name="@POD_ID@_right_carrier"><pose relative_to="@POD_ID@_base_link">0 -0.07 0.055 0 0 0</pose><inertial><mass>0.05</mass><inertia><ixx>0.00002</ixx><iyy>0.00002</iyy><izz>0.00002</izz></inertia></inertial></link>
    <link name="@POD_ID@_left_wheel"><pose relative_to="@POD_ID@_left_carrier">0 0 0 0 0 0</pose><inertial><mass>0.3</mass><inertia><ixx>0.0007</ixx><iyy>0.0012</iyy><izz>0.0007</izz></inertia></inertial><visual name="visual"><pose>0 0 0 1.5708 0 0</pose><geometry><cylinder><radius>0.055</radius><length>0.035</length></cylinder></geometry></visual><collision name="collision"><pose>0 0 0 1.5708 0 0</pose><geometry><cylinder><radius>0.055</radius><length>0.035</length></cylinder></geometry><surface><friction><ode><mu>1.2</mu><mu2>0.35</mu2></ode></friction></surface></collision></link>
    <link name="@POD_ID@_right_wheel"><pose relative_to="@POD_ID@_right_carrier">0 0 0 0 0 0</pose><inertial><mass>0.3</mass><inertia><ixx>0.0007</ixx><iyy>0.0012</iyy><izz>0.0007</izz></inertia></inertial><visual name="visual"><pose>0 0 0 1.5708 0 0</pose><geometry><cylinder><radius>0.055</radius><length>0.035</length></cylinder></geometry></visual><collision name="collision"><pose>0 0 0 1.5708 0 0</pose><geometry><cylinder><radius>0.055</radius><length>0.035</length></cylinder></geometry><surface><friction><ode><mu>1.2</mu><mu2>0.35</mu2></ode></friction></surface></collision></link>
    <joint name="@POD_ID@_left_suspension" type="prismatic"><parent>@POD_ID@_base_link</parent><child>@POD_ID@_left_carrier</child><axis><xyz>0 0 1</xyz><limit><lower>-0.015</lower><upper>0.015</upper><effort>500</effort><velocity>0.5</velocity></limit><dynamics><damping>20</damping><spring_reference>0</spring_reference><spring_stiffness>1000</spring_stiffness></dynamics></axis></joint>
    <joint name="@POD_ID@_right_suspension" type="prismatic"><parent>@POD_ID@_base_link</parent><child>@POD_ID@_right_carrier</child><axis><xyz>0 0 1</xyz><limit><lower>-0.015</lower><upper>0.015</upper><effort>500</effort><velocity>0.5</velocity></limit><dynamics><damping>20</damping><spring_reference>0</spring_reference><spring_stiffness>1000</spring_stiffness></dynamics></axis></joint>
    <joint name="@POD_ID@_left_wheel_joint" type="revolute"><parent>@POD_ID@_left_carrier</parent><child>@POD_ID@_left_wheel</child><axis><xyz>0 1 0</xyz><limit><effort>14</effort><velocity>24</velocity></limit><dynamics><damping>0.05</damping><friction>0.01</friction></dynamics></axis></joint>
    <joint name="@POD_ID@_right_wheel_joint" type="revolute"><parent>@POD_ID@_right_carrier</parent><child>@POD_ID@_right_wheel</child><axis><xyz>0 1 0</xyz><limit><effort>14</effort><velocity>24</velocity></limit><dynamics><damping>0.05</damping><friction>0.01</friction></dynamics></axis></joint>
  </model>

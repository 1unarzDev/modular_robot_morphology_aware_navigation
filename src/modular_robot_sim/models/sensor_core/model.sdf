<?xml version="1.0"?>
<sdf version="1.10">
  <model name="sensor_core">
    <self_collide>true</self_collide>
    <link name="base_link">
      <inertial><mass>7.4</mass><inertia><ixx>0.09</ixx><iyy>0.12</iyy><izz>0.15</izz></inertia></inertial>
      <visual name="body_visual"><geometry><box><size>0.26 0.20 0.12</size></box></geometry><material><diffuse>0.08 0.25 0.55 1</diffuse></material></visual>
      <collision name="body_collision"><geometry><box><size>0.26 0.20 0.12</size></box></geometry></collision>
      <sensor name="imu" type="imu"><topic>/imu</topic><update_rate>100</update_rate><always_on>true</always_on></sensor>
    </link>
    <link name="lidar_link"><pose relative_to="base_link">0 0 0.12 0 0 0</pose><visual name="visual"><geometry><cylinder><radius>0.045</radius><length>0.05</length></cylinder></geometry></visual>
      <sensor name="lidar" type="gpu_lidar"><topic>/scan</topic><update_rate>15</update_rate><lidar><scan><horizontal><samples>720</samples><resolution>1</resolution><min_angle>-3.14159</min_angle><max_angle>3.14159</max_angle></horizontal></scan><range><min>0.08</min><max>15</max><resolution>0.01</resolution></range><noise><type>gaussian</type><mean>0</mean><stddev>0.006</stddev></noise></lidar><always_on>true</always_on><visualize>true</visualize></sensor>
    </link>
    <joint name="lidar_joint" type="fixed"><parent>base_link</parent><child>lidar_link</child></joint>
    <link name="camera_link"><pose relative_to="base_link">0.13 0 0.08 0 0 0</pose>
      <visual name="visual"><geometry><box><size>0.04 0.08 0.04</size></box></geometry></visual>
      <sensor name="rgbd" type="rgbd_camera"><topic>/rgbd_camera</topic><update_rate>15</update_rate>
        <camera><horizontal_fov>1.22</horizontal_fov><image><width>640</width><height>480</height><format>R8G8B8</format></image><clip><near>0.12</near><far>8.0</far></clip><depth_camera><clip><near>0.12</near><far>8.0</far></clip></depth_camera></camera>
        <always_on>true</always_on><visualize>false</visualize>
      </sensor>
    </link>
    <joint name="camera_joint" type="fixed"><parent>base_link</parent><child>camera_link</child></joint>
    <link name="connector_sensor_link">
      <pose relative_to="base_link">0 0 -0.08 0 0 0</pose>
      <sensor name="connector_front" type="logical_camera">
        <topic>/connector_sensor/front</topic><update_rate>20</update_rate><always_on>true</always_on>
        <logical_camera><near>0.05</near><far>1.2</far><horizontal_fov>1.8</horizontal_fov><aspect_ratio>1.0</aspect_ratio></logical_camera>
      </sensor>
      <sensor name="connector_left" type="logical_camera">
        <pose>0 0 0 0 0 1.5707963</pose><topic>/connector_sensor/left</topic>
        <update_rate>20</update_rate><always_on>true</always_on>
        <logical_camera><near>0.05</near><far>1.2</far><horizontal_fov>1.8</horizontal_fov><aspect_ratio>1.0</aspect_ratio></logical_camera>
      </sensor>
      <sensor name="connector_rear" type="logical_camera">
        <pose>0 0 0 0 0 3.1415927</pose><topic>/connector_sensor/rear</topic>
        <update_rate>20</update_rate><always_on>true</always_on>
        <logical_camera><near>0.05</near><far>1.2</far><horizontal_fov>1.8</horizontal_fov><aspect_ratio>1.0</aspect_ratio></logical_camera>
      </sensor>
      <sensor name="connector_right" type="logical_camera">
        <pose>0 0 0 0 0 -1.5707963</pose><topic>/connector_sensor/right</topic>
        <update_rate>20</update_rate><always_on>true</always_on>
        <logical_camera><near>0.05</near><far>1.2</far><horizontal_fov>1.8</horizontal_fov><aspect_ratio>1.0</aspect_ratio></logical_camera>
      </sensor>
    </link>
    <joint name="connector_sensor_joint" type="fixed"><parent>base_link</parent><child>connector_sensor_link</child></joint>
    <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
      <odom_frame>odom</odom_frame><robot_base_frame>core/base_link</robot_base_frame>
      <odom_topic>/odom</odom_topic><tf_topic>/tf</tf_topic><odom_publish_frequency>50</odom_publish_frequency><dimensions>2</dimensions>
    </plugin>
  </model>
</sdf>
